<?xml version="1.0" encoding="utf-8"?>
<!-- Preferences back up and transfer; the device-specific log files
     do not. The path mirrors AppNames.LOG_DIRECTORY_NAME by hand. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="logs/" />
    </device-transfer>
</data-extraction-rules>
